{
  "name": "eol-check",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "fetch-data": "node scripts/fetch-eol.ts",
    "predev": "npm run fetch-data",
    "dev": "astro dev",
    "build": "node scripts/fetch-eol.ts && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm test && npm run build && npm run check",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@kjaniec-dev/design": "^1.0.0",
    "@kjaniec-dev/ui": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}

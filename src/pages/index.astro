---
import data from '../data/eol.json';
import Checker from '../components/Checker.tsx';
import '../styles/global.css';

const generated = data.generatedAt.slice(0, 10);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EOL Check</title>
    <meta name="description" content="Paste package.json, pom.xml, go.mod or a Dockerfile and see which components are past end of support. Runs entirely in your browser." />
    <script is:inline>
      // Follow the OS colour scheme; the design package remaps tokens under .dark
      if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
    </script>
  </head>
  <body>
    <main class="mx-auto max-w-5xl px-4 py-10 flex flex-col gap-6">
      <header class="flex flex-col gap-2">
        <h1 class="m-0 text-3xl font-bold tracking-tight">EOL Check</h1>
        <p class="m-0 text-muted-foreground">
          Paste or drop a <code>package.json</code>, <code>pom.xml</code>, <code>go.mod</code> or <code>Dockerfile</code>.
          Everything is parsed in your browser; nothing is uploaded.
        </p>
      </header>
      <Checker client:load />
      <footer class="text-sm text-muted-foreground">
        Data: <a class="underline" href="https://endoflife.date">endoflife.date</a>, snapshot from {generated}.
      </footer>
    </main>
  </body>
</html>

---
import data from '../data/eol.json';
import Checker from '../components/Checker.tsx';
import '../styles/global.css';

const generated = data.generatedAt.slice(0, 10);
const themes = [
  {
    value: 'light',
    label: 'Light theme',
    icon: 'M16 12a4 4 0 1 1-8 0a4 4 0 0 1 8 0ZM12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42',
  },
  { value: 'dark', label: 'Dark theme', icon: 'M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z' },
  { value: 'system', label: 'System theme', icon: 'M3 4h18v13H3ZM8 21h8m-4-4v4' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EOL Check</title>
    <meta
      name="description"
      content="Check runtime versions, dependency manifests, lockfiles and container images for end of support. Supports Node.js, Python, Java, .NET, PHP, Ruby, Compose and Kubernetes. Runs entirely in your browser."
    />
    <script is:inline>
      (() => {
        const system = matchMedia('(prefers-color-scheme: dark)');
        let theme = 'system';
        try {
          const saved = localStorage.getItem('eol-check-theme');
          if (['light', 'dark', 'system'].includes(saved)) theme = saved;
        } catch {
          // Storage may be unavailable; keep the system theme.
        }
        function apply() {
          const dark = theme === 'dark' || (theme === 'system' && system.matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          document.querySelectorAll('[data-theme]').forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.theme === theme));
          });
        }
        apply();
        system.addEventListener('change', apply);
        document.addEventListener('DOMContentLoaded', () => {
          apply();
          document.querySelectorAll('[data-theme]').forEach((button) => {
            button.addEventListener('click', () => {
              theme = button.dataset.theme;
              try {
                localStorage.setItem('eol-check-theme', theme);
              } catch {
                // Keep the selected theme even when storage is unavailable.
              }
              apply();
            });
          });
        });
      })();
    </script>
  </head>
  <body>
    <main class="mx-auto max-w-5xl px-4 py-10 flex flex-col gap-6">
      <header class="flex flex-col gap-2">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h1 class="m-0 text-3xl font-bold tracking-tight">EOL Check</h1>
          <div class="flex shrink-0 items-center gap-2">
            <div
              role="group"
              aria-label="Theme"
              class="flex items-center gap-0.5 rounded-full border border-border bg-muted/60 p-1"
            >
              {themes.map(({ value, label, icon }) => (
                <button
                  type="button"
                  data-theme={value}
                  aria-label={label}
                  aria-pressed={value === 'system'}
                  title={label}
                  class="inline-flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={icon} />
                  </svg>
                </button>
              ))}
            </div>
            <a
              href="https://github.com/kjaniec-dev/eol-check"
              aria-label="View EOL Check on GitHub"
              title="View on GitHub"
              class="inline-flex size-11 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              <svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true">
                <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.334-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
            </a>
          </div>
        </div>
        <p class="m-0 text-muted-foreground">
          Paste or drop a manifest, lockfile, runtime version file or container configuration.
          Everything is parsed in your browser; nothing is uploaded.
        </p>
        <details class="text-sm text-muted-foreground">
          <summary class="w-fit cursor-pointer rounded-sm underline underline-offset-4 hover:text-foreground">
            Supported formats
          </summary>
          <ul class="mt-3 grid list-disc gap-x-8 gap-y-2 pl-5 sm:grid-cols-2">
            <li>
              <strong>JavaScript:</strong> package.json, package-lock.json, npm-shrinkwrap.json,
              pnpm-lock.yaml, yarn.lock
            </li>
            <li>
              <strong>Runtime versions:</strong> .nvmrc, .node-version, .python-version,
              .ruby-version, .tool-versions, mise.toml, .mise.toml
            </li>
            <li>
              <strong>Python:</strong> pyproject.toml, uv.lock, poetry.lock, Pipfile.lock,
              requirements*.txt / .in
            </li>
            <li>
              <strong>Java / Go:</strong> pom.xml, build.gradle, build.gradle.kts, go.mod
            </li>
            <li>
              <strong>.NET:</strong> global.json, *.csproj, Directory.Build.props,
              *.runtimeconfig.json
            </li>
            <li>
              <strong>PHP / Ruby:</strong> composer.json, composer.lock, Gemfile.lock
            </li>
            <li>
              <strong>Containers:</strong> Dockerfile, Compose and Kubernetes YAML / JSON
            </li>
          </ul>
          <p class="mt-3">
            Upload version files with their original names, or select the tool when pasting a plain
            version number.
          </p>
        </details>
      </header>
      <Checker client:load />
      <footer class="flex flex-wrap items-center justify-between gap-4 text-sm text-muted-foreground">
        <p class="m-0">
          Data:{' '}
          <a class="underline hover:text-foreground" href="https://endoflife.date">
            endoflife.date
          </a>
          , snapshot from {generated}.
        </p>
        <nav aria-label="Project links" class="flex items-center gap-4">
          <a class="underline hover:text-foreground" href="https://kjaniec.dev">
            kjaniec.dev
          </a>
        </nav>
      </footer>
    </main>
  </body>
</html>
